<?xml version="1.0" ?>
<robot name="gimbal_platform">

  <!-- Gazebo plugins for sensors -->
  <gazebo reference="camera_link">
    <sensor name="camera_sensor" type="camera">
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera name="camera">
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>960</width>
          <height>720</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_frame</frame_name>
        <hack_baseline>0.07</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Lidar sensor -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.26180</min_angle>
            <max_angle>0.26180</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.27</min>
          <max>25</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <argument>~/out:=lidar_points</argument>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Joint controllers using gazebo_ros_control -->
  <gazebo>
    <plugin name="gimbal_controller" filename="libgazebo_ros2_control.so">
      <parameters>$(find simulator)/config/gimbal_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Joint states publisher -->
  <gazebo>
    <plugin name="joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <joint_name>pan_joint</joint_name>
      <joint_name>tilt_joint</joint_name>
      <update_rate>100</update_rate>
    </plugin>
  </gazebo>

</robot>
