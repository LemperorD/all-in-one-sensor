<?xml version="1.0"?>
<robot name="gimbal_platform" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="base_length" value="0.2"/>
  <xacro:property name="base_width" value="0.2"/>
  <xacro:property name="base_height" value="0.05"/>

  <xacro:property name="pan_radius" value="0.03"/>
  <xacro:property name="tilt_radius" value="0.03"/>
  <xacro:property name="joint_length" value="0.1"/>

  <xacro:property name="camera_length" value="0.08"/>
  <xacro:property name="camera_width" value="0.05"/>
  <xacro:property name="camera_height" value="0.05"/>

  <xacro:property name="lidar_radius" value="0.03"/>
  <xacro:property name="lidar_height" value="0.04"/>

  <!-- Base link (fixed platform) -->
  <link name="base">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.05" iyz="0.0" izz="0.08"/>
      <origin xyz="0 0 0.025"/>
    </inertial>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
    </collision>
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 0.025"/>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <!-- Pan joint (yaw) - rotates around Z axis -->
  <joint name="pan_joint" type="revolute">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base"/>
    <child link="pan_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="2.0"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="pan_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="${pan_radius}" length="${joint_length}"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <visual>
      <geometry>
        <cylinder radius="${pan_radius}" length="${joint_length}"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
  </link>

  <!-- Tilt joint (pitch) - rotates around Y axis -->
  <joint name="tilt_joint" type="revolute">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="pan_link"/>
    <child link="tilt_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57080" upper="1.57080" effort="10" velocity="2.0"/>
    <dynamics damping="0.5"/>
  </joint>

  <link name="tilt_link">
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.0005"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="${tilt_radius}" length="${joint_length}"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <visual>
      <geometry>
        <cylinder radius="${tilt_radius}" length="${joint_length}"/>
      </geometry>
      <origin xyz="0 0 0.05"/>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
  </link>

  <!-- Camera sensor frame -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
    <parent link="tilt_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <collision>
      <geometry>
        <box size="${camera_width} ${camera_length} ${camera_height}"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="${camera_width} ${camera_length} ${camera_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- Camera optical frame (where images are produced) -->
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

  <link name="camera_optical_frame"/>

  <!-- Lidar sensor frame -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0.05 0.15" rpy="0 0 0"/>
    <parent link="tilt_link"/>
    <child link="lidar_link"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1"/>
      </material>
    </visual>
  </link>

</robot>
