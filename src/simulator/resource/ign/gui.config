<?xml version="1.0"?>

<window>
  <width>1200</width>
  <height>900</height>
</window>

<plugin filename="MinimalScene" name="3D View">
  <ignition-gui>
    <title>3D View</title>
    <property key="width" type="double">1200</property>
    <property key="height" type="double">900</property>
    <property key="state" type="string">docked</property>
  </ignition-gui>
</plugin>
